<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Remove hardware features and permissions absent or unneeded on Realme C21Y (ARM64 phone). -->
    <uses-feature android:name="android.hardware.type.pc" android:required="false" tools:node="remove" />
    <uses-feature android:name="android.software.leanback" android:required="false" tools:node="remove" />
    <uses-feature android:name="android.hardware.location" android:required="false" tools:node="remove" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" tools:node="remove" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" tools:node="remove" />

    <uses-permission android:name="archos.permission.FULLSCREEN.FULL" tools:node="remove" />
    <uses-permission-sdk-23 android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission-sdk-23 android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission-sdk-23 android:name="android.permission.TRANSMIT_IR" tools:node="remove" />

    <application>
        <profileable android:shell="true" android:enabled="true" tools:node="remove" />
    </application>
</manifest>
